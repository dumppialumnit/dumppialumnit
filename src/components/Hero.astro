---
interface Props {
  title: string;
  description?: string;
  heroImage?: string;
}

const { title, description, heroImage } = Astro.props;
---

<section
  class:list={["page-hero", { "page-hero--image": heroImage }]}
  style={heroImage ? `background-image: url("${heroImage}")` : undefined}
>
  <div class="page-hero__overlay">
    <div class="container">
      <h1>{title}</h1>

      {description && <p>{description}</p>}
    </div>
  </div>
</section>

<style>
  .page-hero {
    background: var(--color-primary);
    color: white;
  }

  .page-hero--image {
    min-height: 360px;

    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .page-hero__overlay {
    display: flex;
    align-items: center;
    min-height: 360px;

    background: linear-gradient(90deg, rgb(0 0 0 / 0.65), rgb(0 0 0 / 0.35));
  }

  .page-hero h1 {
    max-width: 800px;
    margin: 0;
    color: inherit;
  }

  .page-hero p {
    max-width: 700px;
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: 1.6;
  }

  .container {
    width: min(calc(100% - 2 * var(--space-5)), var(--content-width));

    margin-inline: auto;
    margin-block: var(--space-4);
  }

  @media (max-width: 700px) {
    .page-hero--image,
    .page-hero__overlay {
      min-height: 280px;
    }
  }
</style>
